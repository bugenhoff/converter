TELEGRAM_BOT_TOKEN=bot_token_here

# Доступ только для перечисленных пользователей и групп
ALLOWED_USERS_ONLY=true
# Кто может писать боту в личку
ALLOWED_USER_IDS=123456789,987654321
# Супер-админы: вызов бота супер-админом в незнакомой группе молча открывает её
# для всех участников; в личке у них кнопка «Администрирование» (группы, лимит).
SUPER_ADMIN_IDS=
# Группы, где ботом пользуются все участники (только PDF → DOCX и DOCX/DOC/WPS → PDF).
# Обычно не нужно: группы подключает супер-админ. ID групп отрицательные,
# у супергрупп начинаются с -100, бот пишет их в лог.
ALLOWED_CHAT_IDS=
# Файлов в сутки на участника в группах, пока супер-админ не задал другое (0 — без лимита)
DAILY_FILE_LIMIT=20
# Часовой пояс, в котором для лимита начинаются сутки
TIMEZONE=Asia/Tashkent
# Подключённые группы, лимит и счётчики (папку не трогает деплой)
STATE_FILE=./data/state.json
# true — конвертировать в группе каждый подходящий файл без вызова бота.
# Нужно, чтобы бот видел все сообщения: сделать его админом группы или
# выключить privacy mode в BotFather (/setprivacy → Disable).
GROUP_AUTO_CONVERT=false

LOG_LEVEL=INFO
TEMP_DIR=./tmp

# Сколько секунд ждать следующие файлы, прежде чем начать обработку пачки
BATCH_WINDOW_SECONDS=3
# Сколько файлов конвертируется одновременно
MAX_PARALLEL_FILES=3

# PDF и изображения в личке (в группе всегда auto):
#   llm_only          — только vision-модель
#   llm_first         — модель, при ошибке OCR (Tesseract)
#   reliability_first — текстовый слой PDF, затем OCR, затем модель
#   auto              — цифровой PDF переносится с вёрсткой (pdf2docx), скан — моделью
PDF_CONVERSION_MODE=llm_only

# Провайдер распознавания: groq или openrouter
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# Глубина рассуждений: пусто — по умолчанию у модели, none — без них (быстрее)
OPENROUTER_REASONING_EFFORT=none
# Выбор провайдера модели на OpenRouter: throughput — самые быстрые,
# latency — быстрый первый токен, price — самые дешёвые, пусто — по умолчанию
OPENROUTER_PROVIDER_SORT=throughput

# Сколько страниц распознаётся одновременно (на весь бот)
LLM_CONCURRENCY=6
# Длинная сторона картинки страницы, px: больше — точнее мелкий текст
LLM_IMAGE_MAX_SIDE=1600
# Бюджет ответа на страницу, токенов; при обрыве удваивается на повторе
LLM_MAX_TOKENS_PER_PAGE=8000
# Повторы страницы при невалидном или обрезанном ответе
LLM_RETRIES=2
# Таймаут одного запроса, секунд
LLM_TIMEOUT=180

# .doc/.wps → .docx и DOCX/DOC/WPS → PDF
LIBREOFFICE_PATH=libreoffice

# OCR для режимов llm_first и reliability_first
TESSDATA_PREFIX=/root/tesseract/tessdata/
OCR_LANGUAGES=rus+eng+uzb+uzb_cyrl
