TELEGRAM_BOT_TOKEN=bot_token_here

# Доступ только для перечисленных пользователей
ALLOWED_USERS_ONLY=true
ALLOWED_USER_IDS=123456789,987654321

LOG_LEVEL=INFO
TEMP_DIR=./tmp

# Сколько секунд ждать следующие файлы, прежде чем начать обработку пачки
BATCH_WINDOW_SECONDS=3
# Сколько файлов конвертируется одновременно
MAX_PARALLEL_FILES=3

# PDF и изображения:
#   llm_only          — только vision-модель
#   llm_first         — модель, при ошибке OCR (Tesseract)
#   reliability_first — текстовый слой PDF, затем OCR, затем модель
PDF_CONVERSION_MODE=llm_only

# Провайдер распознавания: groq или openrouter
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# Глубина рассуждений: пусто — по умолчанию у модели, none — без них (быстрее)
OPENROUTER_REASONING_EFFORT=none
# Выбор провайдера модели на OpenRouter: throughput — самые быстрые,
# latency — быстрый первый токен, price — самые дешёвые, пусто — по умолчанию
OPENROUTER_PROVIDER_SORT=throughput

# Сколько страниц распознаётся одновременно (на весь бот)
LLM_CONCURRENCY=6
# Длинная сторона картинки страницы, px: больше — точнее мелкий текст
LLM_IMAGE_MAX_SIDE=1600
# Бюджет ответа на страницу, токенов; при обрыве удваивается на повторе
LLM_MAX_TOKENS_PER_PAGE=8000
# Повторы страницы при невалидном или обрезанном ответе
LLM_RETRIES=2
# Таймаут одного запроса, секунд
LLM_TIMEOUT=180

# .doc → .docx
LIBREOFFICE_PATH=libreoffice

# OCR для режимов llm_first и reliability_first
TESSDATA_PREFIX=/root/tesseract/tessdata/
OCR_LANGUAGES=rus+eng+uzb+uzb_cyrl
